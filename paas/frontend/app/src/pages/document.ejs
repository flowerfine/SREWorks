<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="theme-color" content="#000000">
  <script>
    window.__ABM_LOAD_START__ = (new Date).getTime();
    window.REMOTE_COMP_LIST = []
    window.REMOTE_VUE_LIST = []
  </script>
  <link rel="manifest" href="./manifest.json">
  <link rel="shortcut icon" href="./new_favicon.png">
  <link rel="stylesheet" type="text/css" href="./screen_loading.css" />
  <link rel="stylesheet" type="text/css" href="./iconfont/iconfont.css" />
  <link href="./vendors/element-ui/2.15.9/index.css" rel="stylesheet">
  <title>SREWorks</title>
  <style type="text/css">
    :root {
    --PrimaryColor: #00bcd4;
    --PrimaryBackColor: #00bcd421;
   }
  </style>
</head>

<body>
  <noscript>
    You need to enable JavaScript to run this app.
  </noscript>
  <script src="./vendors/moment/2.27.0/moment.min.js"></script>
  <script src="./vendors/react/16.14.0/react.production.min.js"></script>
  <script src="./vendors/react-dom/16.14.0/react-dom.production.min.js"></script>
  <script src="./vendors/vue/2.7.9/vue.min.js"></script>
  <script src="./vendors/vuera/0.2.7/vuera.iife.js"></script>
  <script src="./vendors/element-ui/2.15.9/index.js"></script>
  <script src="./vendors/bizcharts/4.1.15/BizCharts.min.js"></script>
  <script src="./vendors/react-ace/10.1.0/main.js"></script>
  <script src="./vendors/lodash/4.17.21/lodash.min.js"></script>
  <script src="./vendors/jquery/3.6.1/jquery.min.js"></script>
  <script src="./vendors/html2canvas/1.4.1/html2canvas.min.js"></script>

  <div id="<%= context.config.mountElementId || 'root' %>" style="min-width: 1400px;overflow: hidden">
    <div id="abm-pre-screen-loading">
      <div id="abm-pre-screen-loading-center">
        <div id="abm-pre-screen-loading-center-absolute">
          <div class="abm-pre-screen-object" id="abm-pre-screen-object_four"></div>
          <div class="abm-pre-screen-object" id="abm-pre-screen-object_three"></div>
          <div class="abm-pre-screen-object" id="abm-pre-screen-object_two"></div>
          <div class="abm-pre-screen-object" id="abm-pre-screen-object_one"></div>
        </div>
        <h1 class="abm-pre-screen-text">
          <span id="abm_logo_text_id">SREWorks</span>
        </h1>
      </div>
    </div>
  </div>

  <script src="./vendors/antd/4.17.4/antd.min.js"></script>
  <script src="./vendors/systemjs/6.10.2/system.min.js"></script>
  <link rel="stylesheet/less" type="text/css" href="./color.less" />
  <script type="text/javascript" src="./config.js" ></script>
  <script>
    window.less = {
      async: false,
      javascriptEnabled: true,
      env: 'production'
    };
    if (window.GlobalBackendConf && window.GlobalBackendConf.production) {
      var targetDom = document.getElementById('loading-mark')
      if (targetDom) {
        targetDom.innerHTML = window.GlobalBackendConf['production']['platformName'] || "SREWorks"
      }
    }
  </script>
</body>

</html>
